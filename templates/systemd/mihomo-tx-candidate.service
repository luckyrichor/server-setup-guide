# /etc/systemd/system/mihomo-tx-candidate.service
[Unit]
Description=TX Mihomo with Webshare routing, TUN and DNS protection
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=3

[Service]
Type=exec
User=serveruser
InaccessiblePaths=/run/dbus/system_bus_socket /run/systemd/resolve
ExecStartPre=+/usr/local/libexec/mihomo-tx-control guard-up
ExecStart=/usr/local/bin/mihomo -d /var/lib/mihomo-tx/active
ExecStartPost=+/usr/local/libexec/mihomo-tx-control dns-up
ExecStopPost=+/usr/local/libexec/mihomo-tx-control stopped
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
Restart=no
TimeoutStartSec=60s
TimeoutStopSec=120s
KillMode=control-group

[Install]
WantedBy=multi-user.target
