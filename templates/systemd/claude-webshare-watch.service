[Unit]
Description=Check Webshare and block and stop Claude during outages
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/claude-webshare-watch.py --config /etc/claude-webshare-watch/config.json
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/apparmor.d/claude-webshare-gate
