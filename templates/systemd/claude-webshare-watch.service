[Unit]
Description=Check Webshare and stop current Claude tasks once per outage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/claude-webshare-watch.py --config /etc/claude-webshare-watch/config.json
TimeoutStartSec=55
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
