[Unit]
Description=Continuously stop Claude tasks during Webshare outages
After=apparmor.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/claude-webshare-watch.py --config /etc/claude-webshare-watch/config.json --guard
Restart=always
RestartSec=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
