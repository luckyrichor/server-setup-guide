[Unit]
Description=Check and update npm Claude CLI stable version daily
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/serveruser/.local/share/claude-daily-update
ExecStart=/usr/bin/python3 /home/serveruser/.local/share/claude-daily-update/run.py
TimeoutStartSec=15min
UMask=0077
